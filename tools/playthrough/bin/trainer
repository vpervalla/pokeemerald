#!/bin/bash
# trainer X Y NAME : talk to the trainer at (X,Y) (intro saved as shots/tr_NAME.png), then fight with
# move ${SLOT:-0}. SWITCH/RESHARE pass through to fight.
pick $1 $2 tr_$3 >/dev/null
for i in 1 2 3 4 5 6; do st | grep -q ENEMY && break; g A w60 >/dev/null; done
g w150 >/dev/null
fight ${SLOT:-0}
st | sed -n 1,3p
