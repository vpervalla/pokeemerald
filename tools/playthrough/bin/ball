#!/bin/bash
# ball : in a wild battle at the action menu, throw one POKé BALL (pocket forced), wait for the result.
g hR5 w15 >/dev/null 2>&1; g A w100 >/dev/null 2>&1
for k in 1 2 3 4 5; do [ "$(pocket)" = "1" ] && break; g hR5 w30 >/dev/null 2>&1; done
g A w50 A w250 >/dev/null 2>&1
for k in 1 2 3 4 5 6 7 8; do g w60 >/dev/null 2>&1; done
