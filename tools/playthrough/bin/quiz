#!/bin/bash
# quiz X Y ANSWER : Cinnabar Gym quiz machine at (X,Y) (read facing north from (X,Y+1)); ANSWER yes|no. A wrong answer brings
# the room's trainer (fought with SWITCH=auto TYPES=${FTYPES:-move}); either way the gate opens.
FTYPES=${FTYPES:-move} mgo1 $1 $(($2 + 1)) | tail -1
g hU3 w6 A w60 >/dev/null
for i in $(seq 8); do python3 "$(dirname "$0")/../tx.py" 2>/dev/null | head -1 | grep -q "?$" && break; g A w60 >/dev/null; done
python3 "$(dirname "$0")/../tx.py" 2>/dev/null | head -1
[ "$3" = no ] && g hD3 w8 >/dev/null
g A w80 >/dev/null
for i in $(seq 8); do inbattle | grep -q battle && break; g A w60 >/dev/null; done
inbattle | grep -q battle && SWITCH=auto TYPES=${FTYPES:-move} fight 0 40 | tail -1 | cut -c1-100
for i in 1 2 3 4; do g B w50 >/dev/null; done
python3 "$(dirname "$0")/../tx.py" 2>/dev/null | head -1
