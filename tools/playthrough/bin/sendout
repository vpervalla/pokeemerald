#!/bin/bash
# sendout K : in the forced "Choose a POKeMON" screen after a faint, pick party slot K (0-5) and confirm SEND OUT.
# The cursor starts on slot 0 (left); slots 1-5 are the right column, top to bottom.
if [ "$1" -ge 1 ]; then g hR4 w10 >/dev/null; for i in $(seq 2 $1); do g hD4 w10 >/dev/null; done; fi
g A w20 A w120 >/dev/null
st | grep ENEMY | cut -c1-70
