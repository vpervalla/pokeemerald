#!/bin/bash
# mpick G N X Y : mgo next to (X,Y) on map G.N (any floor), face it and press A (an item ball, a person, a statue);
# prints the text that came up.
D=$(dirname "$0")
mgo "$1" "$2" "$3" "$4" adj | tail -1
p=$(st | head -1 | grep -o "pos ([0-9]*,[0-9]*)" | tr -d 'pos ()'); px=${p%,*}; py=${p#*,}
if [ "$px" -lt "$3" ]; then k=hR3; elif [ "$px" -gt "$3" ]; then k=hL3; elif [ "$py" -lt "$4" ]; then k=hD3; else k=hU3; fi
g $k w6 A w60 >/dev/null
python3 "$D/../tx.py" 2>/dev/null | head -1
