#!/bin/bash
# aftercatch : after "Gotcha!", get through the dex page and answer NO to the nickname with B, back to the overworld.
# (st prints the map from RAM even inside a battle, so no map check: fixed key sequence.)
g A w120 A w120 >/dev/null 2>&1
g B w150 B w150 B w100 >/dev/null 2>&1
st | head -1
