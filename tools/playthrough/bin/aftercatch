#!/bin/bash
# aftercatch : after "Gotcha!", get through the dex page and answer NO to the nickname with B, back to the overworld.
for i in 1 2 3 4; do g A w120 >/dev/null 2>&1; done
g B w100 >/dev/null 2>&1
for i in 1 2 3; do st | head -1 | grep -q "Route\|City\|Cave\|Moon" && break; g B w80 >/dev/null 2>&1; done
st | head -1
