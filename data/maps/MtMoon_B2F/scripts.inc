@ END KANTO NPCS

@ LUNA got lost in MT. MOON, and a wild CHARMANDER (a SQUIRTLE if the player chose CHARMANDER) corners
@ her at the end of the passage below the STAR PIECE. Walking up to them starts the scene. If the
@ player doesn't catch the POKéMON, LUNA still gets away, and it stays there to be battled again.

MtMoon_B2F_OnTransitionLuna:
	call EventScript_SetMtMoonStarterGfx
	call_if_unset FLAG_RESCUED_MT_MOON_GIRL, MtMoon_B2F_EventScript_ReadyLunaScene
	goto MtMoon_B2F_OnTransition

MtMoon_B2F_EventScript_ReadyLunaScene::
	setvar VAR_TEMP_5, 1
	return

MtMoon_B2F_EventScript_Luna::
	lock
	faceplayer
	goto MtMoon_B2F_EventScript_LunaSceneStart

MtMoon_B2F_EventScript_LunaScene::
	lockall
MtMoon_B2F_EventScript_LunaSceneStart:
	call EventScript_GetMtMoonStarter
	playmoncry VAR_0x8008, CRY_MODE_ENCOUNTER
	applymovement LOCALID_MT_MOON_STARTER, MtMoon_B2F_Movement_StarterMenaces
	waitmovement 0
	waitmoncry
	applymovement LOCALID_MT_MOON_LUNA, Kanto_Common_Movement_FacePlayer
	waitmovement 0
	msgbox MtMoon_B2F_Text_LunaHelp
	closemessage
	applymovement LOCALID_MT_MOON_STARTER, MtMoon_B2F_Movement_StarterNoticesPlayer
	waitmovement 0
	msgbox MtMoon_B2F_Text_StarterTurnsOnYou
	closemessage
	goto MtMoon_B2F_EventScript_StarterBattle

MtMoon_B2F_EventScript_Starter::
	lock
	faceplayer
	call EventScript_GetMtMoonStarter
	playmoncry VAR_0x8008, CRY_MODE_ENCOUNTER
	waitmoncry
	goto_if_unset FLAG_RESCUED_MT_MOON_GIRL, MtMoon_B2F_EventScript_LunaSceneStart
	msgbox MtMoon_B2F_Text_StarterStillAngry
	closemessage
MtMoon_B2F_EventScript_StarterBattle::
	copyvar VAR_0x8004, VAR_0x8008
	setvar VAR_0x8005, 10
	setvar VAR_0x8006, ITEM_NONE
	special CreateEnemyEventMon
	dowildbattle
	specialvar VAR_RESULT, GetBattleOutcome
	call_if_eq VAR_RESULT, B_OUTCOME_CAUGHT, MtMoon_B2F_EventScript_CaughtStarter
	goto_if_set FLAG_RESCUED_MT_MOON_GIRL, MtMoon_B2F_EventScript_StarterBattleEnd
	call EventScript_GetMtMoonStarter
	applymovement LOCALID_MT_MOON_LUNA, Kanto_Common_Movement_FacePlayer
	waitmovement 0
	msgbox MtMoon_B2F_Text_LunaThankYou
	goto_if_set FLAG_CAUGHT_MT_MOON_STARTER, MtMoon_B2F_EventScript_LunaCaught
	msgbox MtMoon_B2F_Text_LunaNotCaught
	goto MtMoon_B2F_EventScript_LunaLeaves

MtMoon_B2F_EventScript_LunaCaught::
	msgbox MtMoon_B2F_Text_LunaCaught
MtMoon_B2F_EventScript_LunaLeaves::
	msgbox MtMoon_B2F_Text_LunaGoingHome
	closemessage
	fadescreen FADE_TO_BLACK
	removeobject LOCALID_MT_MOON_LUNA
	setvar VAR_TEMP_5, 0
	fadescreen FADE_FROM_BLACK
MtMoon_B2F_EventScript_StarterBattleEnd::
	release
	end

MtMoon_B2F_EventScript_CaughtStarter::
	removeobject LOCALID_MT_MOON_STARTER
	return

MtMoon_B2F_Movement_StarterMenaces:
	face_right
	jump_in_place_right
	jump_in_place_right
	step_end

MtMoon_B2F_Movement_StarterNoticesPlayer:
	face_left
	emote_exclamation_mark
	walk_left
	step_end

