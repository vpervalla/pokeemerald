    .string "This {STR_VAR_1} won't let me go!\n"
    .string "Every time I move, it gets angrier!$"

MtMoon_B2F_Text_StarterTurnsOnYou:
    .string "The wild {STR_VAR_1} turned on\n"
    .string "{PLAYER}!$"

MtMoon_B2F_Text_StarterStillAngry:
    .string "The {STR_VAR_1} is still glaring\n"
    .string "at {PLAYER}!$"

MtMoon_B2F_Text_LunaThankYou:
    .string "Th-thank you!\n"
    .string "I'm LUNA.\p"
    .string "I came to see the CLEFAIRY dance,\n"
    .string "but I got lost in the dark…$"

MtMoon_B2F_Text_LunaCaught:
