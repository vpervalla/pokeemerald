@ A double-exchange trader (see data/scripts/double_exchange.inc). They exchange only once.
LavenderTown_PokemonCenter_1F_EventScript_DoubleExchangeTrader::
	lock
	faceplayer
	setvar VAR_0x8008, INGAME_TRADE_EXCHANGE_LAVENDER_TOWN
	goto_if_set FLAG_DID_DOUBLE_EXCHANGE_LAVENDER_TOWN, EventScript_DoubleExchangeAlreadyDone
	call EventScript_DoubleExchange
	goto_if_eq VAR_RESULT, FALSE, EventScript_DoubleExchangeEnd
	setflag FLAG_DID_DOUBLE_EXCHANGE_LAVENDER_TOWN
	release
	end
