@ Team Aqua and Team Magma, after the first Hall of Fame (see data/scripts/hoenn_story.inc). SHELLY
@ and TABITHA are at the lab's fireproof safe; once both are beaten, they flee with half of the PRIMAL
@ NOTES each, and BLAINE comes down and asks the player to follow them to Hoenn.
PokemonMansion_B1F_OnTransition::
	call HoennStory_EventScript_UpdateMansion
	end

PokemonMansion_B1F_EventScript_AquaGrunt::
	trainerbattle_single TRAINER_MANSION_AQUA_GRUNT_F, PokemonMansion_B1F_Text_AquaGruntIntro, PokemonMansion_B1F_Text_AquaGruntDefeat
	msgbox PokemonMansion_B1F_Text_AquaGruntPostBattle, MSGBOX_AUTOCLOSE
	end

PokemonMansion_B1F_EventScript_MagmaGrunt::
	trainerbattle_single TRAINER_MANSION_MAGMA_GRUNT_F, PokemonMansion_B1F_Text_MagmaGruntIntro, PokemonMansion_B1F_Text_MagmaGruntDefeat
	msgbox PokemonMansion_B1F_Text_MagmaGruntPostBattle, MSGBOX_AUTOCLOSE
	end

PokemonMansion_B1F_EventScript_Shelly::
	trainerbattle_single TRAINER_SHELLY_MANSION, PokemonMansion_B1F_Text_ShellyIntro, PokemonMansion_B1F_Text_ShellyDefeat, PokemonMansion_B1F_EventScript_DefeatedAdmin
	goto PokemonMansion_B1F_EventScript_DefeatedAdmin
	end

PokemonMansion_B1F_EventScript_Tabitha::
	trainerbattle_single TRAINER_TABITHA_MANSION, PokemonMansion_B1F_Text_TabithaIntro, PokemonMansion_B1F_Text_TabithaDefeat, PokemonMansion_B1F_EventScript_DefeatedAdmin
	goto PokemonMansion_B1F_EventScript_DefeatedAdmin
	end

PokemonMansion_B1F_EventScript_DefeatedAdmin::
	goto_if_not_defeated TRAINER_SHELLY_MANSION, PokemonMansion_B1F_EventScript_TabithaWaits
	goto_if_not_defeated TRAINER_TABITHA_MANSION, PokemonMansion_B1F_EventScript_ShellyWaits
	goto PokemonMansion_B1F_EventScript_AdminsFlee
	end

PokemonMansion_B1F_EventScript_ShellyWaits::
	msgbox PokemonMansion_B1F_Text_ShellyPostBattle, MSGBOX_AUTOCLOSE
	end

PokemonMansion_B1F_EventScript_TabithaWaits::
	msgbox PokemonMansion_B1F_Text_TabithaPostBattle, MSGBOX_AUTOCLOSE
	end

PokemonMansion_B1F_EventScript_AdminsFlee::
	lockall
	msgbox PokemonMansion_B1F_Text_ShellyFlees
	msgbox PokemonMansion_B1F_Text_TabithaFlees
	closemessage
	fadescreen FADE_TO_BLACK
	playse SE_FLEE
	setflag FLAG_HIDE_MANSION_RAIDERS
	removeobject LOCALID_MANSION_SHELLY
	removeobject LOCALID_MANSION_TABITHA
	removeobject LOCALID_MANSION_AQUA_GRUNT
	removeobject LOCALID_MANSION_MAGMA_GRUNT
	waitse
	@ BLAINE has come down to the player: just south of them, facing them, above the text box
	getplayerxy VAR_0x8004, VAR_0x8005
	addvar VAR_0x8005, 1
	setobjectxyperm LOCALID_MANSION_BLAINE, VAR_0x8004, VAR_0x8005
	clearflag FLAG_HIDE_MANSION_BLAINE
	addobject LOCALID_MANSION_BLAINE
	turnobject LOCALID_PLAYER, DIR_SOUTH
	fadescreen FADE_FROM_BLACK
	msgbox PokemonMansion_B1F_Text_BlaineArrives
	msgbox PokemonMansion_B1F_Text_BlainePrimalNotes
	msgbox PokemonMansion_B1F_Text_BlaineFollowThem
	closemessage
	setvar VAR_HOENN_STORY_STATE, 3
	setflag FLAG_HOENN_OPEN
	fadescreen FADE_TO_BLACK
	removeobject LOCALID_MANSION_BLAINE
	setflag FLAG_HIDE_MANSION_BLAINE
	fadescreen FADE_FROM_BLACK
	releaseall
	end

PokemonMansion_B1F_Text_AquaGruntIntro:
	.string "A kid? Down here?\n"
	.string "TEAM AQUA doesn't take visitors!$"

PokemonMansion_B1F_Text_AquaGruntDefeat:
	.string "Not fair…$"

PokemonMansion_B1F_Text_AquaGruntPostBattle:
	.string "With that power, the sea will\n"
	.string "cover the whole world!\p"
	.string "…Oops. Forget I said that.$"

PokemonMansion_B1F_Text_MagmaGruntIntro:
	.string "TABITHA said nobody gets past!\n"
	.string "And I mean nobody!$"

PokemonMansion_B1F_Text_MagmaGruntDefeat:
	.string "Too hot to handle…$"

PokemonMansion_B1F_Text_MagmaGruntPostBattle:
	.string "More land for people and POKéMON!\n"
	.string "That's all TEAM MAGMA wants!$"

PokemonMansion_B1F_Text_ShellyIntro:
	.string "SHELLY: Ahahaha!\n"
	.string "The KANTO CHAMPION, in person!\p"
	.string "This safe held this lab's last\n"
	.string "secret, and TEAM AQUA takes it.\p"
	.string "Not that MAGMA idiot, and not you!$"

PokemonMansion_B1F_Text_ShellyDefeat:
	.string "Ahahaha! Not bad at all…$"

PokemonMansion_B1F_Text_ShellyPostBattle:
	.string "SHELLY: TABITHA, you clod!\n"
	.string "Don't let that kid near the safe!$"

PokemonMansion_B1F_Text_TabithaIntro:
	.string "TABITHA: Hehehe!\n"
	.string "You're too late, kid.\p"
	.string "The file is TEAM MAGMA's, once\n"
	.string "that AQUA woman is out of the way…\p"
	.string "And you're in the way too!$"

PokemonMansion_B1F_Text_TabithaDefeat:
	.string "Hehehe… I lost?$"

PokemonMansion_B1F_Text_TabithaPostBattle:
	.string "TABITHA: Hey, AQUA lady!\n"
	.string "Keep that kid busy!$"

PokemonMansion_B1F_Text_ShellyFlees:
	.string "SHELLY: Ahahaha! Who cares?\n"
	.string "Half the file is already mine!\p"
	.string "The BLUE ORB… KYOGRE's true form…\n"
	.string "ARCHIE will be so pleased!$"

PokemonMansion_B1F_Text_TabithaFlees:
	.string "TABITHA: And the other half is\n"
	.string "TEAM MAGMA's! Hehehe!\p"
	.string "With the RED ORB, GROUDON will\n"
	.string "show its PRIMAL form for MAXIE!\p"
	.string "Back to HOENN, everyone!$"

PokemonMansion_B1F_Text_BlaineArrives:
	.string "BLAINE: Hah! {PLAYER}!\n"
	.string "Are you all right?\p"
	.string "They got away by boat… with both\n"
	.string "halves of the file, I'm afraid.$"

PokemonMansion_B1F_Text_BlainePrimalNotes:
	.string "I told you our notes burned.\n"
	.string "Not all of them did.\p"
	.string "That safe kept one file: our\n"
	.string "research on where Mega Evolution\l"
	.string "comes from.\p"
	.string "An old legend of HOENN calls it\n"
	.string "PRIMAL REVERSION.\p"
	.string "KYOGRE and GROUDON, touched by the\n"
	.string "BLUE and RED ORBS, return to the\l"
	.string "form they had when they shaped the\l"
	.string "sea and the land.\p"
	.string "Mega Evolution is only its echo.\p"
	.string "Those people want to wake that\n"
	.string "power. If they do, nobody will be\l"
	.string "able to stop it.$"

PokemonMansion_B1F_Text_BlaineFollowThem:
	.string "{PLAYER}, I'm asking you.\n"
	.string "Get the file back.\p"
	.string "A sailor I know at VERMILION can\n"
	.string "take you to SLATEPORT, in HOENN,\l"
	.string "on his SEAGALLOP.\p"
	.string "I'll tell him you're coming.\n"
	.string "Go! And be careful!$"
