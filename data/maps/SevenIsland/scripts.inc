SevenIsland_EventScript_SwordsDanceTutor::
	lock
	faceplayer
	goto_if_set FLAG_TUTOR_SWORDS_DANCE, Kanto_EventScript_SwordsDanceTaught
	msgbox Kanto_Text_SwordsDanceTeach, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Kanto_EventScript_SwordsDanceDeclined
	call Kanto_EventScript_CanOnlyBeLearnedOnce
	goto_if_eq VAR_RESULT, NO, Kanto_EventScript_SwordsDanceDeclined
	msgbox Kanto_Text_SwordsDanceWhichMon
	call Kanto_EventScript_ChooseMoveTutorMon
	goto_if_eq VAR_RESULT, FALSE, Kanto_EventScript_SwordsDanceDeclined
	setflag FLAG_TUTOR_SWORDS_DANCE
	goto Kanto_EventScript_SwordsDanceTaught
	end

