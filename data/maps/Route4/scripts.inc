Route4_EventScript_Boy::
	lock
	faceplayer
	msgbox Route4_Text_PeopleLikeAndRespectBrock
	release
	end

Route4_EventScript_CrissyRematch::
	msgbox Route4_Text_CrissyPostBattle, MSGBOX_AUTOCLOSE
	end

Route4_EventScript_MegaKickTutor::
	lock
	faceplayer
	goto_if_set FLAG_TUTOR_MEGA_KICK, Kanto_EventScript_MegaKickTaught
	msgbox Kanto_Text_MegaKickTeach, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Kanto_EventScript_MegaKickDeclined
	call Kanto_EventScript_CanOnlyBeLearnedOnce
	goto_if_eq VAR_RESULT, NO, Kanto_EventScript_MegaKickDeclined
	msgbox Kanto_Text_MegaKickWhichMon
	call Kanto_EventScript_ChooseMoveTutorMon
	goto_if_eq VAR_RESULT, FALSE, Kanto_EventScript_MegaKickDeclined
	setflag FLAG_TUTOR_MEGA_KICK
	goto Kanto_EventScript_MegaKickTaught
	end

Route4_EventScript_MegaPunchTutor::
	lock
	faceplayer
	goto_if_set FLAG_TUTOR_MEGA_PUNCH, Kanto_EventScript_MegaPunchTaught
	msgbox Kanto_Text_MegaPunchTeach, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Kanto_EventScript_MegaPunchDeclined
	call Kanto_EventScript_CanOnlyBeLearnedOnce
	goto_if_eq VAR_RESULT, NO, Kanto_EventScript_MegaPunchDeclined
	msgbox Kanto_Text_MegaPunchWhichMon
	call Kanto_EventScript_ChooseMoveTutorMon
	goto_if_eq VAR_RESULT, FALSE, Kanto_EventScript_MegaPunchDeclined
	setflag FLAG_TUTOR_MEGA_PUNCH
	goto Kanto_EventScript_MegaPunchTaught
	end

