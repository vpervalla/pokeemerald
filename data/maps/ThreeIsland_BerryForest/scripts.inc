ThreeIsland_BerryForest_Text_WelcomeToBerryForest:
    .string "Welcome to the BERRY FOREST\p"
    .string "Be friendly and share BERRIES with\n"
    .string "others and POKéMON.$"

@ END KANTO NPCS

@ Added (docs/catch_them_all.md, "Johto and Hoenn"): CELEBI, which nothing gave. Once LUGIA and HO-OH are
@ caught at NAVEL ROCK, it waits in the forest's quiet north-west corner, and CELIO hears of it. Beaten or
@ run from, it vanishes and is back the next time the player comes into the forest.
ThreeIsland_BerryForest_EventScript_TryShowCelebi::
	setflag FLAG_HIDE_BERRY_FOREST_CELEBI
	goto_if_set FLAG_CAUGHT_BERRY_FOREST_CELEBI, Kanto_EventScript_Return
	goto_if_unset FLAG_FOUGHT_LUGIA, Kanto_EventScript_Return
	goto_if_unset FLAG_FOUGHT_HO_OH, Kanto_EventScript_Return
	clearflag FLAG_HIDE_BERRY_FOREST_CELEBI
	return

ThreeIsland_BerryForest_OnResume::
	call_if_set FLAG_SYS_SPECIAL_WILD_BATTLE, ThreeIsland_BerryForest_EventScript_TryRemoveCelebi
	end

ThreeIsland_BerryForest_EventScript_TryRemoveCelebi::
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, Kanto_EventScript_Return
	removeobject LOCALID_BERRY_FOREST_CELEBI
	return

ThreeIsland_BerryForest_EventScript_Celebi::
	lock
	faceplayer
	playse SE_PIN
	applymovement LOCALID_BERRY_FOREST_CELEBI, Kanto_Common_Movement_ExclamationMark
	waitmovement 0
	msgbox ThreeIsland_BerryForest_Text_CelebiWatching
	closemessage
	waitse
	playmoncry SPECIES_CELEBI, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	seteventmon SPECIES_CELEBI, 50
	setflag FLAG_SYS_SPECIAL_WILD_BATTLE
	special BattleSetup_StartLegendaryBattle
	waitstate
	clearflag FLAG_SYS_SPECIAL_WILD_BATTLE
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, ThreeIsland_BerryForest_EventScript_CelebiVanished
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, ThreeIsland_BerryForest_EventScript_CelebiVanished
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, ThreeIsland_BerryForest_EventScript_CelebiVanished
	setflag FLAG_CAUGHT_BERRY_FOREST_CELEBI
	release
	end

ThreeIsland_BerryForest_EventScript_CelebiVanished::
	fadescreen FADE_TO_BLACK
	removeobject LOCALID_BERRY_FOREST_CELEBI
	fadescreen FADE_FROM_BLACK
	msgbox ThreeIsland_BerryForest_Text_CelebiVanished
	release
	end

ThreeIsland_BerryForest_Text_CelebiWatching:
	.string "A small POKéMON is floating among\n"
	.string "the leaves, watching {PLAYER}…$"

ThreeIsland_BerryForest_Text_CelebiVanished:
	.string "CELEBI vanished into the trees…$"
