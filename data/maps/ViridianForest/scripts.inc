@ The lost BULBASAUR. Behind the cuttable trees in the north-east, two BEEDRILL have cornered a BULBASAUR
@ that lost its trainer (in VermilionCity_House2) in the forest. Beating (or catching) both sends it home.
@ VAR_TEMP_1 is 0 while the BEEDRILL are still there, which arms the trigger at the clearing's mouth.
ViridianForest_OnTransitionLostBulbasaur::
	call_if_set FLAG_RESCUED_VIRIDIAN_BULBASAUR, ViridianForest_EventScript_DisarmBeedrillAmbush
	goto ViridianForest_OnTransition
	end

ViridianForest_EventScript_DisarmBeedrillAmbush::
	setvar VAR_TEMP_1, 1
	return

ViridianForest_EventScript_BeedrillAmbush::
	lockall
	playmoncry SPECIES_BULBASAUR, CRY_MODE_NORMAL
	waitmoncry
	goto_if_set FLAG_DEFEATED_VIRIDIAN_BEEDRILL_1, ViridianForest_EventScript_OneBeedrillLeft
	msgbox ViridianForest_Text_BulbasaurCornered
	applymovement LOCALID_VIRIDIAN_FOREST_BEEDRILL_1, ViridianForest_Movement_BeedrillNoticePlayer
	waitmovement 0
	msgbox ViridianForest_Text_BeedrillAttacks
	closemessage
	setwildbattle SPECIES_BEEDRILL, 20
	dowildbattle
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, ViridianForest_EventScript_DefeatedFirstBeedrill
	goto_if_eq VAR_RESULT, B_OUTCOME_CAUGHT, ViridianForest_EventScript_DefeatedFirstBeedrill
	goto ViridianForest_EventScript_BeedrillStillThere
	end

ViridianForest_EventScript_DefeatedFirstBeedrill::
	setflag FLAG_DEFEATED_VIRIDIAN_BEEDRILL_1
	removeobject LOCALID_VIRIDIAN_FOREST_BEEDRILL_1
	msgbox ViridianForest_Text_OtherBeedrillIsFurious
	goto ViridianForest_EventScript_SecondBeedrill
	end

@ Back after running from (or losing to) the second BEEDRILL
ViridianForest_EventScript_OneBeedrillLeft::
	msgbox ViridianForest_Text_OneBeedrillLeft
	goto ViridianForest_EventScript_SecondBeedrill
	end

ViridianForest_EventScript_SecondBeedrill::
	applymovement LOCALID_VIRIDIAN_FOREST_BEEDRILL_2, ViridianForest_Movement_BeedrillNoticePlayer
	waitmovement 0
	msgbox ViridianForest_Text_BeedrillAttacks
	closemessage
	setwildbattle SPECIES_BEEDRILL, 20
	dowildbattle
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, ViridianForest_EventScript_DefeatedSecondBeedrill
	goto_if_eq VAR_RESULT, B_OUTCOME_CAUGHT, ViridianForest_EventScript_DefeatedSecondBeedrill
	goto ViridianForest_EventScript_BeedrillStillThere
	end

ViridianForest_EventScript_BeedrillStillThere::
	msgbox ViridianForest_Text_BeedrillStillThere
	releaseall
	end

@ The player stands at the clearing's mouth, (60,5) or (60,6). BULBASAUR comes over, then runs home along the other row.
ViridianForest_EventScript_DefeatedSecondBeedrill::
	setflag FLAG_DEFEATED_VIRIDIAN_BEEDRILL_2
	removeobject LOCALID_VIRIDIAN_FOREST_BEEDRILL_2
	delay 20
	playmoncry SPECIES_BULBASAUR, CRY_MODE_NORMAL
	applymovement LOCALID_VIRIDIAN_FOREST_BULBASAUR, ViridianForest_Movement_BulbasaurHop
	waitmovement 0
	waitmoncry
	getplayerxy VAR_0x8004, VAR_0x8005
	call_if_eq VAR_0x8005, 5, ViridianForest_EventScript_BulbasaurApproachTop
	call_if_ne VAR_0x8005, 5, ViridianForest_EventScript_BulbasaurApproachBottom
	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight
	waitmovement 0
	msgbox ViridianForest_Text_BulbasaurIsGrateful
	playmoncry SPECIES_BULBASAUR, CRY_MODE_NORMAL
	waitmoncry
	msgbox ViridianForest_Text_BulbasaurHasATag
	closemessage
	call_if_eq VAR_0x8005, 5, ViridianForest_EventScript_BulbasaurLeaveBottom
	call_if_ne VAR_0x8005, 5, ViridianForest_EventScript_BulbasaurLeaveTop
	removeobject LOCALID_VIRIDIAN_FOREST_BULBASAUR
	setflag FLAG_RESCUED_VIRIDIAN_BULBASAUR
	clearflag FLAG_HIDE_VERMILION_BULBASAUR
	setvar VAR_TEMP_1, 1
	msgbox ViridianForest_Text_BulbasaurRanHome
	releaseall
	end

ViridianForest_EventScript_BulbasaurApproachTop::
	applymovement LOCALID_VIRIDIAN_FOREST_BULBASAUR, ViridianForest_Movement_BulbasaurApproachTop
	waitmovement 0
	return

ViridianForest_EventScript_BulbasaurApproachBottom::
	applymovement LOCALID_VIRIDIAN_FOREST_BULBASAUR, ViridianForest_Movement_BulbasaurApproachBottom
	waitmovement 0
	return

ViridianForest_EventScript_BulbasaurLeaveBottom::
	applymovement LOCALID_VIRIDIAN_FOREST_BULBASAUR, ViridianForest_Movement_BulbasaurLeaveBottom
	applymovement OBJ_EVENT_ID_PLAYER, ViridianForest_Movement_PlayerWatchBulbasaurBottom
	waitmovement LOCALID_VIRIDIAN_FOREST_BULBASAUR
	return

ViridianForest_EventScript_BulbasaurLeaveTop::
	applymovement LOCALID_VIRIDIAN_FOREST_BULBASAUR, ViridianForest_Movement_BulbasaurLeaveTop
	applymovement OBJ_EVENT_ID_PLAYER, ViridianForest_Movement_PlayerWatchBulbasaurTop
	waitmovement LOCALID_VIRIDIAN_FOREST_BULBASAUR
	return

ViridianForest_EventScript_LostBulbasaur::
	lock
	playmoncry SPECIES_BULBASAUR, CRY_MODE_NORMAL
	msgbox ViridianForest_Text_BulbasaurIsTrembling
	waitmoncry
	release
	end

ViridianForest_EventScript_AngryBeedrill::
	lock
	playmoncry SPECIES_BEEDRILL, CRY_MODE_NORMAL
	msgbox ViridianForest_Text_BeedrillBuzzing
	waitmoncry
	release
	end

ViridianForest_Movement_BeedrillNoticePlayer:
	face_left
	emote_exclamation_mark
	step_end

ViridianForest_Movement_BulbasaurHop:
	jump_in_place_down
	step_end

@ From (62,7) to beside the player, at (61,5) or (61,6)
ViridianForest_Movement_BulbasaurApproachTop:
	walk_left
	walk_up
	walk_up
	face_left
	step_end

ViridianForest_Movement_BulbasaurApproachBottom:
	walk_left
	walk_up
	face_left
	step_end

@ Out of the clearing along the row the player isn't on, and away down the path
ViridianForest_Movement_BulbasaurLeaveBottom:
	walk_fast_down
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	step_end

ViridianForest_Movement_BulbasaurLeaveTop:
	walk_fast_up
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	step_end

ViridianForest_Movement_PlayerWatchBulbasaurBottom:
	delay_8
	face_down
	delay_8
	face_left
	step_end

ViridianForest_Movement_PlayerWatchBulbasaurTop:
	delay_8
	face_up
	delay_8
	face_left
	step_end

