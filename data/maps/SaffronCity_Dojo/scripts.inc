@ Added: after the ELITE FOUR (FLAG_SYS_GAME_CLEAR), the DOJO's trainers are replaced by stronger
@ ones (TRAINER_DOJO_*, see src/data/dojo_trainers.h). Beating MASTER KOICHI, whose MACHAMP Mega
@ Evolves, earns the POKéMON the player didn't pick the first time, so both HITMONLEE and
@ HITMONCHAN can be caught in one game.
SaffronCity_Dojo_OnTransition:
	call_if_unset FLAG_SYS_GAME_CLEAR, SaffronCity_Dojo_EventScript_ShowFirstTrainers
	call_if_set FLAG_SYS_GAME_CLEAR, SaffronCity_Dojo_EventScript_ShowRematchTrainers
	end

SaffronCity_Dojo_EventScript_ShowFirstTrainers:
	clearflag FLAG_HIDE_DOJO_TRAINERS
	setflag FLAG_HIDE_DOJO_REMATCH_TRAINERS
	return

SaffronCity_Dojo_EventScript_ShowRematchTrainers:
	setflag FLAG_HIDE_DOJO_TRAINERS
	clearflag FLAG_HIDE_DOJO_REMATCH_TRAINERS
	return

@ The player can take a POKé BALL if they haven't taken one yet, or once they've won the rematch
SaffronCity_Dojo_EventScript_CheckCanTakeHitmon:
	goto_if_unset FLAG_GOT_HITMON_FROM_DOJO, SaffronCity_Dojo_EventScript_CanTakeHitmon
	goto_if_defeated TRAINER_DOJO_KOICHI, SaffronCity_Dojo_EventScript_CanTakeHitmon
	setvar VAR_RESULT, FALSE
	return

SaffronCity_Dojo_EventScript_CanTakeHitmon:
	setvar VAR_RESULT, TRUE
	return

