@ A woman looks after a BULBASAUR (a SQUIRTLE if the player chose BULBASAUR) that its TRAINER abandoned.
@ It only goes with a TRAINER whose lead POKéMON has a friendship of 150 or more.

CeruleanCity_House5_OnTransition:
	call EventScript_SetCeruleanStarterGfx
	end

CeruleanCity_House5_EventScript_Caretaker::
	lock
	faceplayer
	call EventScript_GetCeruleanStarter
	goto_if_set FLAG_GOT_CERULEAN_STARTER, CeruleanCity_House5_EventScript_CaretakerAfterGift
	goto_if_set FLAG_MET_CERULEAN_STARTER, CeruleanCity_House5_EventScript_CaretakerShowLeadMon
	msgbox CeruleanCity_House5_Text_CaretakerIntro
	setflag FLAG_MET_CERULEAN_STARTER
	goto CeruleanCity_House5_EventScript_CaretakerCheckFriendship

CeruleanCity_House5_EventScript_CaretakerShowLeadMon::
	msgbox CeruleanCity_House5_Text_CaretakerLetsTryAgain
CeruleanCity_House5_EventScript_CaretakerCheckFriendship::
	bufferleadmonspeciesname STR_VAR_2
	msgbox CeruleanCity_House5_Text_ShowedLeadMon
	closemessage
	applymovement LOCALID_CERULEAN_STARTER, Kanto_Common_Movement_WalkInPlaceFasterRight
	waitmovement 0
	specialvar VAR_RESULT, GetLeadMonFriendshipScore
	goto_if_ge VAR_RESULT, FRIENDSHIP_150_TO_199, CeruleanCity_House5_EventScript_StarterTrustsPlayer
	applymovement LOCALID_CERULEAN_STARTER, Kanto_Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	goto_if_eq VAR_RESULT, FRIENDSHIP_100_TO_149, CeruleanCity_House5_EventScript_StarterAlmostTrusts
	msgbox CeruleanCity_House5_Text_StarterWontLook
	release
	end

CeruleanCity_House5_EventScript_StarterAlmostTrusts::
	msgbox CeruleanCity_House5_Text_StarterAlmostTrusts
	release
	end

CeruleanCity_House5_EventScript_StarterTrustsPlayer::
	playmoncry VAR_0x8008, CRY_MODE_NORMAL
	applymovement LOCALID_CERULEAN_STARTER, CeruleanCity_House5_Movement_StarterHappy
	waitmovement 0
	waitmoncry
	msgbox CeruleanCity_House5_Text_StarterCameOut, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CeruleanCity_House5_EventScript_DeclineStarter
	copyvar VAR_TEMP_1, VAR_0x8008
	givemon VAR_0x8008, 12
	goto_if_eq VAR_RESULT, MON_GIVEN_TO_PARTY, CeruleanCity_House5_EventScript_GetStarterParty
	goto_if_eq VAR_RESULT, MON_GIVEN_TO_PC, CeruleanCity_House5_EventScript_GetStarterPC
	goto Kanto_EventScript_NoMoreRoomForPokemon

CeruleanCity_House5_EventScript_DeclineStarter::
	msgbox CeruleanCity_House5_Text_ItWillWait
	release
	end

CeruleanCity_House5_EventScript_GetStarterParty::
	call CeruleanCity_House5_EventScript_ReceivedStarter
	msgbox Kanto_Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CeruleanCity_House5_EventScript_GotStarter
	call Kanto_EventScript_GetGiftMonPartySlot
	call Kanto_EventScript_ChangePokemonNickname
	goto CeruleanCity_House5_EventScript_GotStarter

CeruleanCity_House5_EventScript_GetStarterPC::
	call CeruleanCity_House5_EventScript_ReceivedStarter
	msgbox Kanto_Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CeruleanCity_House5_EventScript_TransferStarterToPC
	call Kanto_EventScript_NameReceivedBoxMon
CeruleanCity_House5_EventScript_TransferStarterToPC::
	call Kanto_EventScript_TransferredToPC
CeruleanCity_House5_EventScript_GotStarter::
	msgbox CeruleanCity_House5_Text_TakeGoodCareOfIt
	release
	end

CeruleanCity_House5_EventScript_ReceivedStarter::
	removeobject LOCALID_CERULEAN_STARTER
	bufferspeciesname STR_VAR_1, VAR_0x8008
	playfanfare MUS_LEVEL_UP
	message CeruleanCity_House5_Text_ReceivedStarter
	waitmessage
	waitfanfare
	bufferspeciesname STR_VAR_1, VAR_0x8008
	return

CeruleanCity_House5_EventScript_CaretakerAfterGift::
	msgbox CeruleanCity_House5_Text_CaretakerAfterGift
	release
	end

CeruleanCity_House5_EventScript_Starter::
	lock
	call EventScript_GetCeruleanStarter
	playmoncry VAR_0x8008, CRY_MODE_NORMAL
	waitmoncry
	msgbox CeruleanCity_House5_Text_StarterHiding
	release
	end

CeruleanCity_House5_Movement_StarterHappy:
	face_right
	emote_exclamation_mark
	jump_in_place_right
	step_end

CeruleanCity_House5_Text_CaretakerIntro:
    .string "Hello. I look after POKéMON that\n"
    .string "were hurt or abandoned.\p"
    .string "That {STR_VAR_1} over there…\n"
    .string "Its TRAINER left it behind on\l"
    .string "NUGGET BRIDGE after it lost a\l"
    .string "battle.\p"
    .string "It's healthy again now, but it\n"
    .string "won't let anyone come near.\p"
    .string "It doesn't trust TRAINERS\n"
    .string "anymore…\p"
    .string "Maybe if it saw a POKéMON that\n"
    .string "truly loves its TRAINER, it would\l"
    .string "change its mind.$"

CeruleanCity_House5_Text_CaretakerLetsTryAgain:
    .string "Oh, it's you again!\n"
    .string "Let's see if the {STR_VAR_1} comes\l"
    .string "out this time.$"

CeruleanCity_House5_Text_ShowedLeadMon:
    .string "{PLAYER} showed {STR_VAR_2}\n"
    .string "to the {STR_VAR_1}.$"

CeruleanCity_House5_Text_StarterWontLook:
    .string "The {STR_VAR_1} won't even look…\p"
    .string "You and your {STR_VAR_2} still need\n"
    .string "to get to know each other.\p"
    .string "Travel together, battle together,\n"
    .string "then come back and try again.$"

CeruleanCity_House5_Text_StarterAlmostTrusts:
    .string "The {STR_VAR_1} peeked out at your\n"
    .string "{STR_VAR_2}… but it's still hiding.\p"
    .string "Your {STR_VAR_2} likes you, but\n"
    .string "not quite enough yet.\p"
    .string "Spend a little more time together,\n"
    .string "then come back!$"

CeruleanCity_House5_Text_StarterCameOut:
    .string "Oh! Look!\n"
    .string "The {STR_VAR_1} came out!\p"
    .string "It saw how much your {STR_VAR_2}\n"
    .string "loves you.\p"
    .string "I think it wants to go with you.\n"
    .string "Will you take it?$"

CeruleanCity_House5_Text_ItWillWait:
    .string "I see…\n"
    .string "It will wait here for you.$"

CeruleanCity_House5_Text_ReceivedStarter:
    .string "{PLAYER} received the {STR_VAR_1}!$"

CeruleanCity_House5_Text_TakeGoodCareOfIt:
    .string "Please take good care of it.\n"
    .string "It's been lonely for so long.$"

CeruleanCity_House5_Text_CaretakerAfterGift:
    .string "I'm so glad the {STR_VAR_1} found a\n"
    .string "TRAINER it can trust.$"

CeruleanCity_House5_Text_StarterHiding:
    .string "The {STR_VAR_1} is hiding behind the\n"
    .string "plants. It looks scared.$"
