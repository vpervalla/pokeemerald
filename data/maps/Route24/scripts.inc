Route24_Movement_RocketApproachPlayer:
	walk_left
	step_end

Route24_Movement_RocketWalkBackToPos:
	walk_right
	walk_in_place_faster_left
	step_end

Route24_Movement_WalkDown:
	walk_down
	step_end

