@ Added: MIGUEL, the SUPER NERD from MT. MOON, studies the fossil the player left him. Once the
@ player brings him the POKéMON revived from their own fossil, he gives them his, so both KABUTO
@ and OMANYTE can be caught in one game.
PewterCity_Museum_1F_OnTransition:
	setflag FLAG_HIDE_PEWTER_MUSEUM_MIGUEL
	call_if_set FLAG_GOT_FOSSIL_FROM_MT_MOON, PewterCity_Museum_1F_EventScript_ShowMiguel
	end

PewterCity_Museum_1F_EventScript_ShowMiguel:
	clearflag FLAG_HIDE_PEWTER_MUSEUM_MIGUEL
	return

PewterCity_Museum_1F_EventScript_Miguel::
	lock
	faceplayer
	goto_if_set FLAG_GOT_FOSSIL_FROM_MIGUEL, PewterCity_Museum_1F_EventScript_MiguelGaveFossil
	goto_if_set FLAG_GOT_HELIX_FOSSIL, PewterCity_Museum_1F_EventScript_MiguelHasDomeFossil
	bufferspeciesname STR_VAR_1, SPECIES_KABUTO
	bufferitemname STR_VAR_2, ITEM_HELIX_FOSSIL
	goto_if_unset FLAG_REVIVED_DOME, PewterCity_Museum_1F_EventScript_MiguelWaitForRevival
	setvar VAR_0x8004, SPECIES_KABUTO
	specialvar VAR_RESULT, DoesPlayerPartyContainSpecies
	goto_if_eq VAR_RESULT, TRUE, PewterCity_Museum_1F_EventScript_MiguelGiveHelixFossil
	setvar VAR_0x8004, SPECIES_KABUTOPS
	specialvar VAR_RESULT, DoesPlayerPartyContainSpecies
	goto_if_eq VAR_RESULT, TRUE, PewterCity_Museum_1F_EventScript_MiguelGiveHelixFossil
	goto PewterCity_Museum_1F_EventScript_MiguelShowMeMon

PewterCity_Museum_1F_EventScript_MiguelHasDomeFossil:
	bufferspeciesname STR_VAR_1, SPECIES_OMANYTE
	bufferitemname STR_VAR_2, ITEM_DOME_FOSSIL
	goto_if_unset FLAG_REVIVED_HELIX, PewterCity_Museum_1F_EventScript_MiguelWaitForRevival
	setvar VAR_0x8004, SPECIES_OMANYTE
	specialvar VAR_RESULT, DoesPlayerPartyContainSpecies
	goto_if_eq VAR_RESULT, TRUE, PewterCity_Museum_1F_EventScript_MiguelGiveDomeFossil
	setvar VAR_0x8004, SPECIES_OMASTAR
	specialvar VAR_RESULT, DoesPlayerPartyContainSpecies
	goto_if_eq VAR_RESULT, TRUE, PewterCity_Museum_1F_EventScript_MiguelGiveDomeFossil
	goto PewterCity_Museum_1F_EventScript_MiguelShowMeMon

PewterCity_Museum_1F_EventScript_MiguelWaitForRevival:
	msgbox PewterCity_Museum_1F_Text_MiguelBringMeRevivedMon
	release
	end

PewterCity_Museum_1F_EventScript_MiguelShowMeMon:
	msgbox PewterCity_Museum_1F_Text_MiguelShowMeMon
	release
	end

PewterCity_Museum_1F_EventScript_MiguelGiveHelixFossil:
	msgbox PewterCity_Museum_1F_Text_MiguelItsAlive
	giveitem ITEM_HELIX_FOSSIL
	goto_if_eq VAR_RESULT, FALSE, PewterCity_Museum_1F_EventScript_MiguelBagFull
	setflag FLAG_GOT_HELIX_FOSSIL
	goto PewterCity_Museum_1F_EventScript_MiguelGotFossil

PewterCity_Museum_1F_EventScript_MiguelGiveDomeFossil:
	msgbox PewterCity_Museum_1F_Text_MiguelItsAlive
	giveitem ITEM_DOME_FOSSIL
	goto_if_eq VAR_RESULT, FALSE, PewterCity_Museum_1F_EventScript_MiguelBagFull
	setflag FLAG_GOT_DOME_FOSSIL
	goto PewterCity_Museum_1F_EventScript_MiguelGotFossil

PewterCity_Museum_1F_EventScript_MiguelGotFossil:
	setflag FLAG_GOT_FOSSIL_FROM_MIGUEL
	msgbox PewterCity_Museum_1F_Text_MiguelTakeItToCinnabar
	release
	end

PewterCity_Museum_1F_EventScript_MiguelBagFull:
	msgbox PewterCity_Museum_1F_Text_MiguelBagFull
	release
	end

PewterCity_Museum_1F_EventScript_MiguelGaveFossil:
	msgbox PewterCity_Museum_1F_Text_MiguelLookForMoreFossils
	release
	end

PewterCity_Museum_1F_Text_MiguelBringMeRevivedMon:
    .string "MIGUEL: Oh! It's you, from MT. MOON!\p"
    .string "I'm studying my {STR_VAR_2} here.\n"
    .string "There's so much to learn from it!\p"
    .string "Hey, did you take your fossil to the\n"
    .string "LAB on CINNABAR ISLAND yet?\p"
    .string "If it really comes back to life as\n"
    .string "a {STR_VAR_1}, come and show me!\p"
    .string "I won't believe it until I see it\n"
    .string "with my own eyes!$"

PewterCity_Museum_1F_Text_MiguelShowMeMon:
    .string "MIGUEL: What? Your fossil came\n"
    .string "back to life?\p"
    .string "Then where's the {STR_VAR_1}?\n"
    .string "Bring it here! I want to see it!$"

PewterCity_Museum_1F_Text_MiguelItsAlive:
    .string "MIGUEL: Whoa! Is that the POKéMON\n"
    .string "from your fossil?\p"
    .string "It's alive! It's really alive!\p"
    .string "… … … … … …\p"
    .string "To me, my fossil is just a rock\n"
    .string "behind glass…\p"
    .string "But it could swim and play like\n"
    .string "yours, couldn't it?\p"
    .string "Here, take my {STR_VAR_2}!\n"
    .string "It deserves to live again, too!$"

PewterCity_Museum_1F_Text_MiguelTakeItToCinnabar:
    .string "Take it to the LAB on CINNABAR\n"
    .string "ISLAND, okay?\p"
    .string "I want it to swim around like\n"
    .string "yours does!$"

PewterCity_Museum_1F_Text_MiguelBagFull:
    .string "Huh? Your BAG is full!\n"
    .string "Make some room and come back.$"

PewterCity_Museum_1F_Text_MiguelLookForMoreFossils:
    .string "MIGUEL: I'm going back to MT. MOON\n"
    .string "to dig for more fossils!\p"
    .string "Maybe one day I'll bring one back\n"
    .string "to life myself!$"

