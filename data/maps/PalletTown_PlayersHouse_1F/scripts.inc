PalletTown_PlayersHouse_1F_Text_YouShouldTakeQuickRest:
    .string "MOM: {PLAYER}!\n"
    .string "You should take a quick rest.$"

@ END KANTO NPCS

@ The Mega Evolution story: after the second Hall of Fame (the League's rematch, once the Sevii
@ Islands quest is done), the player wakes up at home and MOM has a letter for them. It's the
@ invitation to the tournament on APEX ISLAND, from a "MR. M." (MEWTWO, seen by MOM as a man thanks
@ to its powers), with the APEX TICKET for the ship inside. BLAINE gave the MEGA RING, and the
@ MEGA STONES come from strong trainers.

PalletTown_PlayersHouse_1F_OnFrame:
	map_script_2 VAR_HOENN_STORY_STATE, 1, PalletTown_PlayersHouse_1F_EventScript_MomBlaineCalled
	map_script_2 VAR_MEGA_STORY_STATE, 1, PalletTown_PlayersHouse_1F_EventScript_MomHasLetter
	.2byte 0

PalletTown_PlayersHouse_1F_EventScript_MomHasLetter::
	lockall
	applymovement LOCALID_MOM, PalletTown_PlayersHouse_1F_Movement_MomNoticesPlayer
	waitmovement 0
	applymovement LOCALID_PLAYER, PalletTown_PlayersHouse_1F_Movement_PlayerStepsDown
	applymovement LOCALID_MOM, PalletTown_PlayersHouse_1F_Movement_MomWalksToPlayer
	waitmovement 0
	msgbox PalletTown_PlayersHouse_1F_Text_MomLetterCameForYou
	closemessage
	msgbox PalletTown_PlayersHouse_1F_Text_Invitation
	msgbox PalletTown_PlayersHouse_1F_Text_InvitationTicket
	kanto_giveitem_msg PalletTown_PlayersHouse_1F_Text_FoundTicketInLetter, ITEM_APEX_TICKET, 1, MUS_RG_OBTAIN_KEY_ITEM
PalletTown_PlayersHouse_1F_EventScript_MomSeesPlayerOff::
	msgbox PalletTown_PlayersHouse_1F_Text_MomDoYourBest
	closemessage
	setvar VAR_MEGA_STORY_STATE, 2
	clearflag FLAG_HIDE_VERMILION_APEX_SAILOR
	applymovement LOCALID_MOM, PalletTown_PlayersHouse_1F_Movement_MomWalksBack
	waitmovement 0
	releaseall
	end

PalletTown_PlayersHouse_1F_Movement_MomNoticesPlayer:
	face_right
	emote_exclamation_mark
	step_end

PalletTown_PlayersHouse_1F_Movement_PlayerStepsDown:
	walk_down
	step_end

PalletTown_PlayersHouse_1F_Movement_MomWalksToPlayer:
	walk_right
	walk_right
	face_up
	step_end

PalletTown_PlayersHouse_1F_Movement_MomWalksBack:
	walk_left
	walk_left
	face_left
	step_end

PalletTown_PlayersHouse_1F_Text_MomLetterCameForYou:
    .string "MOM: {PLAYER}! You're up!\n"
    .string "Good morning, CHAMPION!\p"
    .string "I'm so proud of you, dear.\p"
    .string "Oh, and a letter came for you.\p"
    .string "A tall gentleman in a long coat\n"
    .string "brought it this morning.\p"
    .string "Such a quiet man… I didn't even\n"
    .string "hear him knock. He just said it was\l"
    .string "for the new CHAMPION, and left.\p"
    .string "Here, it's for you.$"

PalletTown_PlayersHouse_1F_Text_Invitation:
    .string "{PLAYER} opened the letter.\p"
    .string "“To {PLAYER},\n"
    .string "the new CHAMPION of KANTO.\p"
    .string "I have followed your battles with\n"
    .string "great interest.\l"
    .string "You and your POKéMON fight as one.\p"
    .string "There is a power that can take a\n"
    .string "POKéMON beyond its final form.\l"
    .string "Few have ever seen it.\p"
    .string "I wish to see it in the hands of\n"
    .string "the strongest trainers.\p"
    .string "On an island east of VERMILION,\n"
    .string "I am holding a tournament.\l"
    .string "You are cordially invited.\p"
    .string "A ship will wait for you at\n"
    .string "VERMILION HARBOR.$"

PalletTown_PlayersHouse_1F_Text_InvitationTicket:
    .string "With this letter is a ticket for\n"
    .string "the ship.\p"
    .string "Only trainers who can Mega Evolve\n"
    .string "may enter my tournament.\p"
    .string "I have entrusted the MEGA STONES\n"
    .string "to strong trainers of KANTO.\l"
    .string "Defeat them, and claim one.\p"
    .string "Yours sincerely,\n"
    .string "MR. M.”$"

PalletTown_PlayersHouse_1F_Text_FoundTicketInLetter:
    .string "There was something in the letter!\p"
    .string "{PLAYER} found the APEX TICKET!$"

PalletTown_PlayersHouse_1F_Text_MomDoYourBest:
    .string "MOM: A tournament on an island?\n"
    .string "Goodness!\p"
    .string "I'll pack you a lunch for the boat.\p"
    .string "Go on, {PLAYER}.\n"
    .string "Show them what you can do!$"

@ The way to Hoenn (see data/scripts/hoenn_story.inc): after the first Hall of Fame, MOM has a message
@ from BLAINE. Set here rather than at the Hall of Fame, so saves from after it get it too.
PalletTown_PlayersHouse_1F_OnTransition:
	call_if_set FLAG_SYS_GAME_CLEAR, PalletTown_PlayersHouse_1F_EventScript_ReadyBlaineCall
	end

PalletTown_PlayersHouse_1F_EventScript_ReadyBlaineCall::
	goto_if_ne VAR_HOENN_STORY_STATE, 0, Common_EventScript_NopReturn
	setvar VAR_HOENN_STORY_STATE, 1
	return

@ No walking: an older save can get it when coming in from outside.
PalletTown_PlayersHouse_1F_EventScript_MomBlaineCalled::
	lockall
	playse SE_PIN
	applymovement LOCALID_MOM, Common_Movement_ExclamationMark
	waitmovement 0
	msgbox PalletTown_PlayersHouse_1F_Text_MomBlaineCalled
	closemessage
	setvar VAR_HOENN_STORY_STATE, 2
	releaseall
	end

PalletTown_PlayersHouse_1F_Text_MomBlaineCalled:
	.string "MOM: {PLAYER}! You're up!\n"
	.string "Good morning, CHAMPION!\p"
	.string "The phone rang while you were\n"
	.string "asleep. It was BLAINE, the GYM\l"
	.string "LEADER on CINNABAR ISLAND.\p"
	.string "He sounded worried. Strangers in\n"
	.string "red and blue uniforms broke into\l"
	.string "the old POKéMON MANSION.\p"
	.string "He asked if you could come to his\n"
	.string "GYM right away.\p"
	.string "Be careful, dear!$"
