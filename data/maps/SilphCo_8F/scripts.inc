SilphCo_8F_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, SilphCo_8F_OnLoad
	.byte 0

@ BEGIN KANTO NPCS: generated by tools/kanto_port/port_npcs.py from pokefirered. Do not edit by hand.

SilphCo_8F_EventScript_Grunt1::
	trainerbattle_single TRAINER_KANTO_TEAM_ROCKET_GRUNT_32, SilphCo_8F_Text_Grunt1Intro, SilphCo_8F_Text_Grunt1Defeat
	msgbox SilphCo_8F_Text_Grunt1PostBattle, MSGBOX_AUTOCLOSE
	end

SilphCo_8F_EventScript_Grunt2::
	trainerbattle_single TRAINER_KANTO_TEAM_ROCKET_GRUNT_36, SilphCo_8F_Text_Grunt2Intro, SilphCo_8F_Text_Grunt2Defeat
	msgbox SilphCo_8F_Text_Grunt2PostBattle, MSGBOX_AUTOCLOSE
	end

SilphCo_8F_EventScript_Parker::
	trainerbattle_single TRAINER_KANTO_SCIENTIST_PARKER, SilphCo_8F_Text_ParkerIntro, SilphCo_8F_Text_ParkerDefeat
	msgbox SilphCo_8F_Text_ParkerPostBattle, MSGBOX_AUTOCLOSE
	end

SilphCo_8F_EventScript_ItemIron::
	finditem ITEM_IRON
	end

SilphCo_8F_EventScript_Door::
	lockall
	setvar VAR_TEMP_1, 14
	setvar VAR_0x8004, FLAG_SILPH_8F_DOOR
	goto_if_set FLAG_SILPH_8F_DOOR, Kanto_EventScript_DoorUnlocked
	goto Kanto_EventScript_TryUnlockDoor
	end

SilphCo_8F_EventScript_FloorSign::
	msgbox SilphCo_8F_Text_FloorSign, MSGBOX_SIGN
	end

SilphCo_8F_EventScript_Scientist::
	lock
	faceplayer
	goto_if_ge VAR_MAP_SCENE_SILPH_CO_11F, 1, SilphCo_8F_EventScript_ScientistRocketsGone
	famechecker FAMECHECKER_GIOVANNI, 2
	msgbox SilphCo_8F_Text_ToRocketBossMonsAreTools
	release
	end

@ Once GIOVANNI is beaten: the IV CHECKER, his work that TEAM ROCKET wanted
SilphCo_8F_EventScript_ScientistRocketsGone::
	goto_if_set FLAG_RECEIVED_IV_CHECKER, SilphCo_8F_EventScript_ExplainIvChecker
	msgbox SilphCo_8F_Text_TakeIvChecker
	checkitemspace ITEM_IV_CHECKER
	goto_if_eq VAR_RESULT, FALSE, Kanto_EventScript_BagIsFull
	setflag FLAG_RECEIVED_IV_CHECKER
	kanto_giveitem_msg SilphCo_8F_Text_ReceivedIvChecker, ITEM_IV_CHECKER, 1, MUS_RG_OBTAIN_KEY_ITEM
	msgbox SilphCo_8F_Text_ExplainIvChecker
	release
	end

SilphCo_8F_EventScript_ExplainIvChecker::
	msgbox SilphCo_8F_Text_ExplainIvChecker
	release
	end

SilphCo_8F_EventScript_WorkerM::
	lock
	faceplayer
	goto_if_ge VAR_MAP_SCENE_SILPH_CO_11F, 1, SilphCo_8F_EventScript_WorkerMRocketsGone
	msgbox SilphCo_8F_Text_WonderIfSilphIsFinished
	release
	end

SilphCo_8F_EventScript_WorkerMRocketsGone::
	msgbox SilphCo_8F_Text_ThanksForSavingUs
	release
	end

SilphCo_8F_OnLoad::
	call_if_unset FLAG_SILPH_8F_DOOR, Kanto_EventScript_Close8FDoor
	end

SilphCo_8F_Text_FloorSign:
    .string "SILPH CO. HEAD OFFICE\n"
    .string "8F$"

SilphCo_8F_Text_Grunt1Defeat:
    .string "Not enough grit!$"

SilphCo_8F_Text_Grunt1Intro:
    .string "That's as far as you'll go!$"

SilphCo_8F_Text_Grunt1PostBattle:
    .string "If you don't turn back…\n"
    .string "I'll call for backup!$"

SilphCo_8F_Text_Grunt2Defeat:
    .string "Whoo!\n"
    .string "Oh, Brothers!$"

SilphCo_8F_Text_Grunt2Intro:
    .string "I am one of the four ROCKET\n"
    .string "BROTHERS!$"

SilphCo_8F_Text_Grunt2PostBattle:
    .string "I'll leave you up to my brothers.$"

SilphCo_8F_Text_ParkerDefeat:
    .string "Huh?\n"
    .string "I lost?$"

SilphCo_8F_Text_ParkerIntro:
    .string "You're causing us problems!$"

SilphCo_8F_Text_ParkerPostBattle:
    .string "So, what do you think of SILPH\n"
    .string "BUILDING's maze?$"

SilphCo_8F_Text_ThanksForSavingUs:
    .string "Thanks for saving us!$"

SilphCo_8F_Text_ToRocketBossMonsAreTools:
    .string "TEAM ROCKET's BOSS is terribly\n"
    .string "cruel!\p"
    .string "To him, POKéMON are just tools to\n"
    .string "be used.\p"
    .string "What will happen if that tyrant\n"
    .string "takes over our company…$"

SilphCo_8F_Text_TakeIvChecker:
    .string "You saved us from TEAM ROCKET!\n"
    .string "Thank you!\p"
    .string "Their BOSS wanted my latest\n"
    .string "invention to find the strongest\l"
    .string "POKéMON and throw away the rest.\p"
    .string "I'd rather it went to a TRAINER\n"
    .string "who cares for every POKéMON.\p"
    .string "Please, take it!$"

SilphCo_8F_Text_ReceivedIvChecker:
    .string "{PLAYER} received an IV CHECKER\n"
    .string "from the SCIENTIST.$"

SilphCo_8F_Text_ExplainIvChecker:
    .string "The IV CHECKER reads a POKéMON's\n"
    .string "hidden potential, its IVs.\p"
    .string "Each stat has an IV from 0 to 31.\n"
    .string "The higher it is, the better.\p"
    .string "It shows the POKéMON in your\n"
    .string "party and in your PC BOXES.\p"
    .string "It also shows the type and power\n"
    .string "of their HIDDEN POWER.\p"
    .string "But remember: a POKéMON's worth\n"
    .string "isn't just numbers!$"

SilphCo_8F_Text_WonderIfSilphIsFinished:
    .string "I wonder if SILPH is finished…$"

@ END KANTO NPCS
