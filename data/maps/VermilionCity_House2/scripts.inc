VermilionCity_House2_EventScript_AlreadyTraded::
	msgbox VermilionCity_House2_Text_HowIsMyOldMon
	release
	end

VermilionCity_House2_EventScript_DeclineTrade::
	msgbox VermilionCity_House2_Text_ThatsTooBad
	release
	end

VermilionCity_House2_EventScript_Elyssa::
	lock
	faceplayer
	call Kanto_EventScript_GetInGameTradeSpeciesInfo
	goto_if_set FLAG_DID_CH_DING_TRADE, VermilionCity_House2_EventScript_AlreadyTraded
	msgbox VermilionCity_House2_Text_DoYouHaveMonWantToTradeForMyMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, VermilionCity_House2_EventScript_DeclineTrade
	call Kanto_EventScript_ChooseMonForInGameTrade
	goto_if_ge VAR_0x8004, PARTY_SIZE, VermilionCity_House2_EventScript_DeclineTrade
	call Kanto_EventScript_GetInGameTradeSpecies
	goto_if_ne VAR_RESULT, VAR_0x8009, VermilionCity_House2_EventScript_NotRequestedMon
	call Kanto_EventScript_DoInGameTrade
	msgbox VermilionCity_House2_Text_ThankYou
	setflag FLAG_DID_CH_DING_TRADE
	release
	end

VermilionCity_House2_EventScript_NotRequestedMon::
	bufferspeciesname STR_VAR_1, VAR_0x8009
	msgbox VermilionCity_House2_Text_ThisIsNoMon
	release
	end

VermilionCity_House2_Text_DoYouHaveMonWantToTradeForMyMon:
	.string "Hi!\n"
	.string "Do you have a {STR_VAR_1}?\p"
	.string "Want to trade it for my\n"
	.string "{STR_VAR_2}?$"

VermilionCity_House2_Text_HowIsMyOldMon:
	.string "How is my old {STR_VAR_2}?\p"
	.string "My {STR_VAR_1} is doing great!$"

VermilionCity_House2_Text_ThankYou:
	.string "Thank you!$"

VermilionCity_House2_Text_ThatsTooBad:
	.string "That's too bad.$"

VermilionCity_House2_Text_ThisIsNoMon:
	.string "…This is no {STR_VAR_1}.\p"
	.string "If you get one, please trade it\n"
	.string "to me!$"

@ END KANTO NPCS

@ The trainer of the BULBASAUR lost in Viridian Forest. Once the player has saved it from the BEEDRILL
@ (ViridianForest/scripts.inc), it is back home and its trainer gives the player one of their BULBASAUR.
VermilionCity_House2_OnTransition::
	setflag FLAG_HIDE_VERMILION_BULBASAUR
	call_if_set FLAG_RESCUED_VIRIDIAN_BULBASAUR, VermilionCity_House2_EventScript_ShowBulbasaur
	end

VermilionCity_House2_EventScript_ShowBulbasaur::
	clearflag FLAG_HIDE_VERMILION_BULBASAUR
	return

VermilionCity_House2_EventScript_BulbasaurTrainer::
	lock
	faceplayer
	goto_if_set FLAG_GOT_BULBASAUR_FROM_VERMILION_TRAINER, VermilionCity_House2_EventScript_AlreadyGaveBulbasaur
	goto_if_set FLAG_RESCUED_VIRIDIAN_BULBASAUR, VermilionCity_House2_EventScript_GiveBulbasaur
	msgbox VermilionCity_House2_Text_LostMyBulbasaur
	release
	end

VermilionCity_House2_EventScript_GiveBulbasaur::
	msgbox VermilionCity_House2_Text_ThanksForSavingBulbasaur
	setvar VAR_TEMP_1, SPECIES_BULBASAUR
	givemon SPECIES_BULBASAUR, 20
	goto_if_eq VAR_RESULT, 0, VermilionCity_House2_EventScript_GotBulbasaurParty
	goto_if_eq VAR_RESULT, 1, VermilionCity_House2_EventScript_GotBulbasaurPC
	goto_if_eq VAR_RESULT, 2, VermilionCity_House2_EventScript_NoRoomForBulbasaur
	release
	end

VermilionCity_House2_EventScript_GotBulbasaurParty::
	playfanfare MUS_LEVEL_UP
	message VermilionCity_House2_Text_ObtainedABulbasaur
	waitmessage
	waitfanfare
	bufferspeciesname STR_VAR_1, SPECIES_BULBASAUR
	msgbox Kanto_Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, VermilionCity_House2_EventScript_SetGotBulbasaur
	call Kanto_EventScript_GetGiftMonPartySlot
	call Kanto_EventScript_ChangePokemonNickname
	goto VermilionCity_House2_EventScript_SetGotBulbasaur
	end

VermilionCity_House2_EventScript_GotBulbasaurPC::
	playfanfare MUS_LEVEL_UP
	message VermilionCity_House2_Text_ObtainedABulbasaur
	waitmessage
	waitfanfare
	bufferspeciesname STR_VAR_1, SPECIES_BULBASAUR
	msgbox Kanto_Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, VermilionCity_House2_EventScript_TransferBulbasaurToPC
	call Kanto_EventScript_NameReceivedBoxMon
	goto VermilionCity_House2_EventScript_TransferBulbasaurToPC
	end

VermilionCity_House2_EventScript_TransferBulbasaurToPC::
	call Kanto_EventScript_TransferredToPC
	goto VermilionCity_House2_EventScript_SetGotBulbasaur
	end

VermilionCity_House2_EventScript_SetGotBulbasaur::
	setflag FLAG_GOT_BULBASAUR_FROM_VERMILION_TRAINER
	msgbox VermilionCity_House2_Text_TakeGoodCareOfIt
	release
	end

VermilionCity_House2_EventScript_NoRoomForBulbasaur::
	msgbox VermilionCity_House2_Text_NoRoomForBulbasaur
	release
	end

VermilionCity_House2_EventScript_AlreadyGaveBulbasaur::
	msgbox VermilionCity_House2_Text_HowsYourBulbasaur
	release
	end

VermilionCity_House2_EventScript_Bulbasaur::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_BULBASAUR, CRY_MODE_NORMAL
	msgbox VermilionCity_House2_Text_Bulbasaur
	waitmoncry
	release
	end

VermilionCity_House2_Text_LostMyBulbasaur:
    .string "I was walking through VIRIDIAN\n"
    .string "FOREST with my BULBASAUR when a\l"
    .string "swarm of BEEDRILL came at us.\p"
    .string "BULBASAUR got scared and ran off\n"
    .string "into the trees, to the north-east.\p"
    .string "I searched and searched, but the\n"
    .string "trees there are too thick to get\l"
    .string "through…\p"
    .string "If you're ever in the forest,\n"
    .string "please look out for my BULBASAUR!$"

VermilionCity_House2_Text_ThanksForSavingBulbasaur:
    .string "My BULBASAUR came running home\n"
    .string "all by itself!\p"
    .string "It keeps tugging me toward you…\n"
    .string "You saved it from those BEEDRILL,\l"
    .string "didn't you?\p"
    .string "Thank you so much!\p"
    .string "I raise BULBASAUR here, you know.\n"
    .string "Please take one of mine as thanks!$"

VermilionCity_House2_Text_ObtainedABulbasaur:
    .string "{PLAYER} obtained a BULBASAUR!$"

VermilionCity_House2_Text_TakeGoodCareOfIt:
    .string "Take good care of it!\n"
    .string "And steer clear of BEEDRILL nests!$"

VermilionCity_House2_Text_NoRoomForBulbasaur:
    .string "Oh, you can't carry any more\n"
    .string "POKéMON, and your BOXES are full.\p"
    .string "Come back when you've made some\n"
    .string "room for my BULBASAUR!$"

VermilionCity_House2_Text_HowsYourBulbasaur:
    .string "How's the BULBASAUR I gave you?\n"
    .string "Raise it well, and it'll grow into\l"
    .string "a mighty VENUSAUR!$"

VermilionCity_House2_Text_Bulbasaur:
    .string "BULBASAUR: Bulba! Saur!$"
